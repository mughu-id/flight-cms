{% extends 'admin/layout.twig' %}
{% block content %}
<h1 class="text-2xl font-semibold mb-3">Profile</h1>
{% if new_token %}<div class="mb-4 rounded-md px-4 py-3 text-sm border border-border bg-background">Copy this token now. It will not be shown again: <code>{{ new_token }}</code></div>{% endif %}
<form method="post" action="/admin/profile">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <div class="mb-3"><label class="mb-1.5 block text-sm font-medium">Display name</label><input class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" name="display_name" value="{{ user.display_name }}" required></div>
    <div class="mb-3"><label class="mb-1.5 block text-sm font-medium">Email</label><input class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" type="email" name="email" value="{{ user.email }}" required></div>
    <div class="mb-3"><label class="mb-1.5 block text-sm font-medium">Bio</label><textarea class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" name="bio">{{ user.bio }}</textarea></div>
    <div class="mb-3"><label class="mb-1.5 block text-sm font-medium">Current password</label><input class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" type="password" name="current_password"></div>
    <div class="mb-3"><label class="mb-1.5 block text-sm font-medium">New password</label><input class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" type="password" name="password"></div>
    <button class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-xs hover:bg-primary/90">Save</button>
</form>
{% endblock %}
