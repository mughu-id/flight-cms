{% extends 'admin/layout.twig' %}
{% block content %}
<form class="sheet" method="post" action="/admin/settings/api">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label class="field">CORS origins<span class="hint">Comma-separated. Use * to allow any origin.</span><input name="api_cors" value="{{ settings.api_cors|default('') }}"></label>
    <label class="field">Requests per minute<input name="api_rate_limit" value="{{ settings.api_rate_limit|default(60) }}"></label>
    <button type="submit">Save</button>
</form>
{% endblock %}
