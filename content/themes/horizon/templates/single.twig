{% extends '@theme/layout.twig' %}
{% block title %}{{ post.title }} - {{ site_title }}{% endblock %}
{% block content %}
<article class="story">
    <header class="story-head">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {% set cat = category(post) %}
            {% if cat %}
                <span aria-hidden="true">/</span>
                <a href="/{{ setting('category_base', 'category') }}/{{ cat.slug }}">{{ cat.name }}</a>
            {% endif %}
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ post.title }}</span>
        </nav>
        <h1>{{ post.title }}</h1>
        <p class="by"><time datetime="{{ post.published_at }}">{{ post.published_at|local_date }}</time></p>
    </header>
    {% set body = post.content|shortcodes|anchors %}
    {% set outline = toc(body) %}
    {% if outline|length > 1 %}
    <nav class="toc" aria-label="Table of contents">
        <details>
            <summary>On this page <span>{{ outline|length }}</span></summary>
            <ol>
                {% for item in outline %}
                    <li class="toc-{{ item.level }}"><a href="#{{ item.id }}">{{ item.text }}</a></li>
                {% endfor %}
            </ol>
        </details>
    </nav>
    {% endif %}
    <div class="cms-content">{{ body|raw }}</div>
</article>
{% if post.comment_status == 'open' %}
<section class="comments" id="comments">
    <header>
        <h2>Comments</h2>
        <span>{{ post.comment_count }}</span>
    </header>
    {% if flash %}<p class="note {{ flash.type }}">{{ flash.message }}</p>{% endif %}
    <div class="thread">
        {% for comment in comments|default([]) %}
            <article class="comment">
                <span class="avatar">{{ comment.author_name|first|upper }}</span>
                <div>
                    <p class="who"><strong>{{ comment.author_name }}</strong><time>{{ comment.created_at|local_date }}</time></p>
                    <p>{{ comment.content|nl2br }}</p>
                </div>
            </article>
        {% else %}<p class="empty">No comments yet. Be the first.</p>{% endfor %}
    </div>
    <form class="reply" method="post" action="/comments">
        <h3>Write a comment</h3>
        {{ csrf_field()|raw }}
        <input type="hidden" name="post_id" value="{{ post.id }}">
        <input type="hidden" name="redirect" value="{{ permalink(post) }}#comments">
        <input type="hidden" name="started" value="{{ 'now'|date('U') }}">
        <div class="hp"><input name="website" tabindex="-1" autocomplete="off"></div>
        <label>Name<input name="author_name" placeholder="Your name" required></label>
        <label>Email<input type="email" name="author_email" placeholder="you@example.com" required></label>
        <label>Comment<textarea name="content" rows="4" placeholder="What do you think?" required></textarea></label>
        <button type="submit">Post comment</button>
    </form>
</section>
{% endif %}
{% endblock %}
