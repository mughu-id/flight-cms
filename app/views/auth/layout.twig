{% extends 'layout.twig' %}
{% block body_class %}bg-slate-50{% endblock %}
{% block body %}
<div class="mx-auto max-w-md px-4 py-16">
    <h1 class="mb-4 text-xl font-semibold">{{ heading }}</h1>
    {% if flash %}<div class="mb-4 rounded-md px-4 py-3 text-sm {{ flash.type == 'error' ? 'bg-red-50 text-red-800' : 'bg-emerald-50 text-emerald-800' }}">{{ flash.message }}</div>{% endif %}
    {% if error is defined and error %}<div class="mb-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">{{ error }}</div>{% endif %}
    {% block form %}{% endblock %}
</div>
{% endblock %}
