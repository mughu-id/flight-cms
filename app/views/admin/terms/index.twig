{% extends 'admin/layout.twig' %}
{% block content %}
<div class="page-bar"><h1>{{ taxonomy.label }}</h1></div>
<div class="term-layout">
    <form class="panel term-add" method="post" action="/admin/terms/{{ taxonomy.slug }}">
        <header>Add {{ taxonomy.label_singular|lower }}</header>
        <div class="term-add-body">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <label>Name<input name="name" placeholder="Name" required></label>
            <label>Slug<input name="slug" placeholder="Slug"></label>
            {% if taxonomy.hierarchical %}
                <label>Parent
                    <select name="parent_id"><option value="0">No parent</option>{% for term in terms %}<option value="{{ term.id }}">{{ term.name }}</option>{% endfor %}</select>
                </label>
            {% endif %}
            <label>Description<textarea name="description" rows="3" placeholder="Description"></textarea></label>
            <button type="submit">Add</button>
        </div>
    </form>
    <section class="board">
        <table class="board-table">
            <thead><tr><th>Name</th><th>Slug</th><th>Count</th><th></th></tr></thead>
            <tbody>
            {% for term in terms %}
                <tr>
                    <td><input form="term-{{ term.id }}" name="name" value="{{ term.name }}" required></td>
                    <td><input form="term-{{ term.id }}" name="slug" value="{{ term.slug }}"></td>
                    <td class="muted">{{ term.count }}</td>
                    <td class="actions">
                        <form id="term-{{ term.id }}" method="post" action="/admin/terms/{{ taxonomy.slug }}/{{ term.id }}">
                            <input type="hidden" name="csrf" value="{{ csrf }}">
                            <button class="icon-btn border-input" type="submit" title="Save" aria-label="Save">{{ icon('check') }}</button>
                        </form>
                        <form method="post" action="/admin/terms/{{ taxonomy.slug }}/{{ term.id }}/delete">
                            <input type="hidden" name="csrf" value="{{ csrf }}">
                            <button class="icon-btn destructive" type="submit" title="Delete" aria-label="Delete">{{ icon('trash') }}</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="empty">None yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
</div>
{% endblock %}
