{
    "name": "flightcms/flight-cms",
    "description": "WordPress-style CMS built on Flight PHP and SQLite",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "cocur/slugify": "^4.7",
        "flightphp/cache": "^1.1",
        "flightphp/core": "^3.19",
        "flightphp/permissions": "^0.2",
        "flightphp/runway": "^1.2",
        "flightphp/session": "^0.3",
        "flightphp/tracy-extensions": "^0.3",
        "intervention/image": "^4.3",
        "jfcherng/php-diff": "^7.0",
        "level-2/dice": "^4.0",
        "symfony/html-sanitizer": "^7.4",
        "symfony/mailer": "^7.4",
        "tinymce/tinymce": "^8.0",
        "tracy/tracy": "^2.10",
        "twbs/bootstrap-icons": "^1.11",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/commands/"
        ],
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "start": "@php -S localhost:1155 -t . router.php",
        "test": "phpunit",
        "migrate": "@php runway migrate",
        "assets": "@php runway assets:publish",
        "post-install-cmd": [
            "@php scripts/setup.php"
        ],
        "post-update-cmd": [
            "@php scripts/setup.php"
        ]
    }
}
