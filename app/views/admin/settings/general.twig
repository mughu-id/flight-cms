{% extends 'admin/layout.twig' %}
{% block content %}
<form class="sheet" method="post" action="/admin/settings/general">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label class="field">Site title<input name="site_title" value="{{ settings.site_title|default('') }}"></label>
    <label class="field">Tagline<input name="tagline" value="{{ settings.tagline|default('') }}"></label>
    <label class="field">Timezone<input name="timezone" value="{{ settings.timezone|default('UTC') }}"></label>
    <label class="field">Date format<input name="date_format" value="{{ settings.date_format|default('F j, Y') }}"></label>
    <label class="check"><input type="checkbox" name="registration_open" value="1" {{ settings.registration_open ? 'checked' : '' }}> Anyone can register</label>
    <button type="submit">Save</button>
</form>
{% endblock %}
