# Sample Nginx config — document root is the project folder.
server {
    listen 80;
    server_name example.com;
    root /path/to/FLIGHT CMS;
    index index.php;

    location ~ ^/(app|vendor|storage|database|scripts|tests|resources|content|node_modules|deploy)/ {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/uploads/.*\.(php|phtml|phar)$ {
        deny all;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass 127.0.0.1:9000;
    }
}
