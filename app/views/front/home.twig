{% extends 'layout.twig' %}
{% block body %}
<main class="mx-auto max-w-5xl px-4 py-10">
    <h1>{{ site_title }}</h1>
    {% for post in posts %}
        <article class="mb-4">
            <h2 class="text-xl font-semibold">{{ post.title }}</h2>
            <div>{{ post.content|raw }}</div>
        </article>
    {% endfor %}
</main>
{% endblock %}
