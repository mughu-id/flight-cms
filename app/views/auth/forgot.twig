{% extends 'auth/layout.twig' %}
{% set heading = 'Forgot password' %}
{% block form %}
<form method="post" action="/admin/forgot-password">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <div class="mb-3"><label class="mb-1 block text-sm font-medium text-slate-700">Email</label><input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" type="email" name="email" required></div>
    <button class="inline-flex items-center justify-center rounded-md px-3 py-1.5 text-sm font-medium bg-slate-900 text-white hover:bg-slate-700">Send reset link</button>
</form>
{% endblock %}
