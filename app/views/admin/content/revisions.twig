{% extends 'admin/layout.twig' %}
{% block content %}
<h1 class="text-2xl font-semibold">Revisions: {{ post.title }}</h1>
<p><a href="/admin/content/{{ type.slug }}/{{ post.id }}">Back to editor</a></p>
<form method="get" class="grid grid-cols-12 gap-4 mb-3">
    <div class="col-span-12 md:col-span-8"><select class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" name="a">{% for rev in revisions %}<option value="{{ rev.id }}">{{ rev.created_at }} {{ rev.is_autosave ? '(autosave)' : '' }}</option>{% endfor %}</select></div>
    <div class="col-span-12 md:col-span-8"><select class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm shadow-xs outline-none focus-visible:ring-2 focus-visible:ring-ring/30" name="b">{% for rev in revisions %}<option value="{{ rev.id }}">{{ rev.created_at }} {{ rev.is_autosave ? '(autosave)' : '' }}</option>{% endfor %}</select></div>
    <div class="col-span-12 w-auto md:col-span-3"><button class="inline-flex h-8 items-center justify-center rounded-md border border-input bg-background px-3 text-sm font-medium shadow-xs hover:bg-accent">Compare</button></div>
</form>
{% if diff %}<div class="mb-4">{{ diff|raw }}</div>{% endif %}
<ul class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card">
    {% for rev in revisions %}
        <li class="flex items-center justify-between bg-card px-3 py-2">
            <span>{{ rev.created_at }} by {{ rev.author_name }} {{ rev.is_autosave ? '(autosave)' : '' }}</span>
            <form method="post" action="/admin/content/{{ type.slug }}/{{ post.id }}/revisions/{{ rev.id }}/restore">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <button class="icon-btn border-input" title="Restore" aria-label="Restore">{{ icon('undo') }}</button>
            </form>
        </li>
    {% else %}<li class="flex items-center justify-between bg-card px-3 py-2 text-muted-foreground">No revisions yet.</li>{% endfor %}
</ul>
{% endblock %}
