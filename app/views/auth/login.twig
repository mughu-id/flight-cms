{% extends 'auth/layout.twig' %}
{% set heading = 'Log in' %}
{% block form %}
<form method="post" action="/admin/login">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <div class="mb-3"><label class="mb-1 block text-sm font-medium text-slate-700">Username or email</label><input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" name="login" required autofocus></div>
    <div class="mb-3"><label class="mb-1 block text-sm font-medium text-slate-700">Password</label><input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" type="password" name="password" required></div>
    <div class="flex items-center gap-2 mb-3"><input class="size-4 rounded border-slate-300" type="checkbox" name="remember" value="1" id="remember"><label class="text-sm" for="remember">Remember me</label></div>
    <button class="inline-flex items-center justify-center rounded-md px-3 py-1.5 text-sm font-medium bg-slate-900 text-white hover:bg-slate-700 w-full">Log in</button>
    <div class="mt-3"><a href="/admin/forgot-password">Forgot password?</a></div>
    {% if registration %}<div class="mt-1"><a href="/admin/register">Register</a></div>{% endif %}
</form>
{% endblock %}
