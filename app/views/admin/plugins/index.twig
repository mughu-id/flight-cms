{% extends 'admin/layout.twig' %}
{% block content %}
<div class="page-bar"><h1>Plugins</h1></div>
<table class="w-full text-left text-sm"><thead><tr><th>Plugin</th><th>Version</th><th></th></tr></thead><tbody>
{% for slug, plugin in plugins %}
<tr>
    <td><strong>{{ plugin.name }}</strong><br><small class="text-muted-foreground">{{ plugin.description|default('') }}</small></td>
    <td>{{ plugin.version }}</td>
    <td>
        {% if slug in active %}
            <form method="post" action="/admin/plugins/{{ slug }}/deactivate" class="inline-flex"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="inline-flex h-8 items-center justify-center rounded-md border border-input bg-background px-3 text-xs font-medium hover:bg-accent">Deactivate</button></form>
        {% else %}
            <form method="post" action="/admin/plugins/{{ slug }}/activate" class="inline-flex"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="inline-flex h-8 items-center justify-center rounded-md bg-primary px-3 text-xs font-medium text-primary-foreground hover:bg-primary/90">Activate</button></form>
        {% endif %}
    </td>
</tr>
{% else %}<tr><td colspan="3" class="text-muted-foreground">No plugins.</td></tr>{% endfor %}
</tbody></table>
{% endblock %}
