{% extends 'auth/layout.twig' %}
{% set heading = 'Register' %}
{% block form %}
<form method="post" action="/admin/register">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <div class="mb-3"><label class="mb-1 block text-sm font-medium text-slate-700">Username</label><input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" name="username" required pattern="[a-z0-9_]{3,30}"></div>
    <div class="mb-3"><label class="mb-1 block text-sm font-medium text-slate-700">Email</label><input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" type="email" name="email" required></div>
    <div class="mb-3"><label class="mb-1 block text-sm font-medium text-slate-700">Password</label><input class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm" type="password" name="password" required minlength="8"></div>
    <button class="inline-flex items-center justify-center rounded-md px-3 py-1.5 text-sm font-medium bg-slate-900 text-white hover:bg-slate-700">Create account</button>
</form>
{% endblock %}
